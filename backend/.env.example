# Somente desenvolvimento em banco descartável. Nunca use credenciais reais aqui.
AGROFROTA_ENV=development
AGROFROTA_ENABLE_DEV_ROUTES=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agrofrota_dev
DB_PASSWORD=preencha_localmente
DB_NAME=agrofrota_test_central
SECRET_KEY=preencha_com_valor_aleatorio_local
JWT_SECRET_KEY=preencha_com_outro_valor_aleatorio_local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Assistente acadêmico: usa somente modelos Ollama já instalados localmente.
AGRO_AI_MODEL=llama3.1:8b
AGRO_AI_OLLAMA_URL=http://127.0.0.1:11434
AGRO_AI_TIMEZONE=America/Sao_Paulo
# AGRO_AI_INDEX_PATH=/caminho/local/fora-do-vault/agrofrota-vault.sqlite3

# Configuração atualmente suportada; produção ainda não homologada.
JWT_ACCESS_TOKEN_EXPIRES=3600
FLASK_DEBUG=0
